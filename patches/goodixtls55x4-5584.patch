--- /dev/null
+++ b/libfprint/sigfm/sigfm-stub.cpp
@@ -0,0 +1,46 @@
+// Minimal SIGFM stub for environments without opencv4/doctest.
+//
+// Satisfies the C ABI declared in sigfm.hpp so libfprint links. Every
+// function reports failure or empty results; SIGFM matching is unavailable.
+// Drivers using FPI_DEVICE_ALGO_NBIS never call into this code.
+
+#include "sigfm.hpp"
+
+#include <cstdlib>
+
+struct SigfmImgInfo {
+    int unused;
+};
+
+SigfmImgInfo* sigfm_extract(const SfmPix* /*pix*/, int /*width*/, int /*height*/) {
+    auto* info = static_cast<SigfmImgInfo*>(std::malloc(sizeof(SigfmImgInfo)));
+    info->unused = 0;
+    return info;
+}
+
+void sigfm_free_info(SigfmImgInfo* info) {
+    std::free(info);
+}
+
+int sigfm_match_score(SigfmImgInfo* /*frame*/, SigfmImgInfo* /*enrolled*/) {
+    return -1;
+}
+
+unsigned char* sigfm_serialize_binary(SigfmImgInfo* /*info*/, int* outlen) {
+    *outlen = 0;
+    return nullptr;
+}
+
+SigfmImgInfo* sigfm_deserialize_binary(const unsigned char* /*bytes*/, int /*len*/) {
+    return nullptr;
+}
+
+int sigfm_keypoints_count(SigfmImgInfo* /*info*/) {
+    return 0;
+}
+
+SigfmImgInfo* sigfm_copy_info(SigfmImgInfo* info) {
+    auto* copy = static_cast<SigfmImgInfo*>(std::malloc(sizeof(SigfmImgInfo)));
+    copy->unused = info->unused;
+    return copy;
+}
