index 417a37c..0290854 100644
--- a/libfprint/drivers/goodixtls/goodix.c
+++ b/libfprint/drivers/goodixtls/goodix.c
@@ -75,6 +75,83 @@ data_to_str (guint8 *data, guint32 length)
   return string;
 }
 
+// ---- 27c6:5584 per-device secrets (read from a gitignored local file) ----
+
+#define GOODIX_5584_SECRETS_DEFAULT "captures/psk.hex"
+
+static guint8 goodix_5584_psk[32];
+static guint8 goodix_5584_psk_hash[32];
+
+static gboolean
+goodix_5584_load_secrets (void)
+{
+  static gint state = 0; // 0 = not tried, 1 = loaded, -1 = failed
+  const char *path;
+  g_autofree gchar *contents = NULL;
+  g_auto (GStrv) lines = NULL;
+
+  if (state != 0)
+    return state == 1;
+
+  path = g_getenv ("GOODIX5584_SECRETS_FILE");
+  if (!path)
+    path = GOODIX_5584_SECRETS_DEFAULT;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    {
+      fp_err ("could not read 5584 secrets file '%s'", path);
+      state = -1;
+      return FALSE;
+    }
+
+  lines = g_strsplit_set (contents, "\r\n", -1);
+  guint line_no = 0;
+  for (guint i = 0; lines[i] != NULL && line_no < 2; i++)
+    {
+      const gchar *hex = lines[i];
+
+      if (*hex == '\0' || *hex == '#')
+        continue;
+      if (strlen (hex) != 64)
+        {
+          fp_err ("5584 secrets file '%s': line %u is not 64 hex chars",
+                  path, i);
+          state = -1;
+          return FALSE;
+        }
+
+      guint8 *out = line_no == 0 ? goodix_5584_psk : goodix_5584_psk_hash;
+      for (guint n = 0; n < 32; n++)
+        if (sscanf (hex + n * 2, "%2hhx", out + n) != 1)
+          {
+            state = -1;
+            return FALSE;
+          }
+      line_no++;
+    }
+
+  state = line_no == 2 ? 1 : -1;
+  if (state == -1)
+    fp_err ("5584 secrets file '%s': expected psk and hash lines", path);
+  return state == 1;
+}
+
+const guint8 *
+goodix_5584_get_psk (void)
+{
+  if (!goodix_5584_load_secrets ())
+    return NULL;
+  return goodix_5584_psk;
+}
+
+const guint8 *
+goodix_5584_get_psk_hash (void)
+{
+  if (!goodix_5584_load_secrets ())
+    return NULL;
+  return goodix_5584_psk_hash;
+}
+
 // ---- GOODIX RECEIVE SECTION START ----
 
 void
